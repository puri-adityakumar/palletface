{
  // Static assets on Cloudflare Workers (built from /site). Run `npm run build` before `npx wrangler deploy` or `npx wrangler preview`.
  "name": "palletface",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./dist",
    // /playground and /changelog have no file of their own, so direct links and refreshes need index.html.
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "palletface.palletism.art", "custom_domain": true }],
  "workers_dev": false,
  // Required by `npx wrangler preview` for Cloudflare Workers PR preview builds.
  "previews": {}
}
