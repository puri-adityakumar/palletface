{
  "name": "dither-face",
  "version": "0.1.0",
  "description": "Deterministic seeded SVG avatars — pixel and ascii faces picked from a user id, so they never change between renders.",
  "type": "module",
  "license": "MIT",
  "author": "puri-adityakumar <kumar.adityapuri@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puri-adityakumar/dither-face.git"
  },
  "bugs": {
    "url": "https://github.com/puri-adityakumar/dither-face/issues"
  },
  "homepage": "https://github.com/puri-adityakumar/dither-face#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "build:web": "esbuild src/index.ts --bundle --format=iife --global-name=DitherFace --outfile=dist/dither-face.js",
    "sheet": "npm run build && node scripts/render-sheet.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepack": "rm -rf dist && npm run check && npm run build:web"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
