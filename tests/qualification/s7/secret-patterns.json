{
  "stage": "S7",
  "version": "s7-conservative-1",
  "createdBeforeExecution": "2026-11-04",
  "note": "Pinned conservative credential classifier for S7-06. Patterns target well-known token shapes, private-key blocks, and auth-like environment assignments. Reports must contain only file, line, and type; never the matching text. No generic entropy scan is used, so a clean result is not proof that arbitrary prose contains no secret.",
  "patterns": [
    {
      "id": "aws-access-key",
      "type": "aws_access_key",
      "regex": "AKIA[0-9A-Z]{16}",
      "flags": "g"
    },
    {
      "id": "github-token",
      "type": "github_token",
      "regex": "gh[pousr]_[A-Za-z0-9]{36,}",
      "flags": "g"
    },
    {
      "id": "github-fine-grained-token",
      "type": "github_fine_grained_token",
      "regex": "github_pat_[A-Za-z0-9_]{22,255}",
      "flags": "g"
    },
    {
      "id": "npm-token",
      "type": "npm_token",
      "regex": "npm_[A-Za-z0-9]{36}",
      "flags": "g"
    },
    {
      "id": "slack-token",
      "type": "slack_token",
      "regex": "xox[baprs]-[A-Za-z0-9-]{10,}",
      "flags": "g"
    },
    {
      "id": "google-api-key",
      "type": "google_api_key",
      "regex": "AIza[0-9A-Za-z_-]{35}",
      "flags": "g"
    },
    {
      "id": "stripe-live-key",
      "type": "stripe_live_key",
      "regex": "sk_live_[0-9A-Za-z]{24,}",
      "flags": "g"
    },
    {
      "id": "private-key-block",
      "type": "private_key_block",
      "regex": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----",
      "flags": "g"
    },
    {
      "id": "jwt",
      "type": "jwt",
      "regex": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
      "flags": "g"
    },
    {
      "id": "auth-env-assignment",
      "type": "auth_env_assignment",
      "regex": "(?:AWS_SECRET_ACCESS_KEY|AWS_ACCESS_KEY_ID|GITHUB_TOKEN|GH_TOKEN|NPM_TOKEN|NODE_AUTH_TOKEN|CLOUDFLARE_API_TOKEN|CLOUDFLARE_API_KEY|BL_API_KEY|BL_API_TOKEN)\\s*[:=]\\s*['\\\"]?[A-Za-z0-9/+=_-]{12,}",
      "flags": "g"
    }
  ],
  "excludedFileNamePatterns": [
    "(?:^|/)\\.env(?:\\.[^/]*)?$",
    "(?:^|/)\\.git(?:/|$)",
    "(?:^|/)node_modules(?:/|$)",
    "(?:^|/)\\.npmrc$",
    "(?:^|/)\\.netrc$",
    "(?:^|/)\\.git-credentials$",
    "(?:^|/)id_(?:rsa|ed25519|ecdsa|dsa)(?:\\.pub)?$",
    "(?:^|/)[^/]*\\.(?:pem|key|p12|pfx)$",
    "(?:^|/)[^/]*\\.(?:bak|backup|orig|rej|swp)$",
    "(?:^|/)[^/]*~$",
    "(?:^|/)\\.DS_Store$"
  ]
}
